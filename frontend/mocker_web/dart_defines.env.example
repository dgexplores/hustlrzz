# Firebase web app configuration template.
#
# Copy this file to `dart_defines.env` and replace every YOUR_*_HERE value
# with the config from your Firebase project:
#   Firebase console -> Project settings -> Your apps -> Web app
#
#   cp dart_defines.env.example dart_defines.env
#
# Then run/build the app with:
#   flutter run --dart-define-from-file=dart_defines.env
#   flutter build web --release --dart-define-from-file=dart_defines.env
#
# NOTE: FIREBASE_MEASUREMENT_ID is optional for Firebase Auth to work, but
# keeping it here matches the config generated by `flutterfire configure`.
FIREBASE_API_KEY=YOUR_API_KEY_HERE
FIREBASE_APP_ID=YOUR_APP_ID_HERE
FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID_HERE
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID_HERE
FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID_HERE
