# Supabase configuration template.
#
# Copy this file to `dart_defines.env` and replace every YOUR_*_HERE value:
#   Supabase dashboard -> Project Settings -> API (or Dashboard -> Connect)
#
#   cp dart_defines.env.example dart_defines.env
#
# Then run/build the app with:
#   flutter run --dart-define-from-file=dart_defines.env
#   flutter build web --release --dart-define-from-file=dart_defines.env
#
# NOTE: SUPABASE_ANON_KEY is the public (publishable) key — safe to ship in
# the browser. Data is protected by Row-Level Security (supabase_schema.sql)
# and the backend's service-role key, which is never exposed to clients.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_or_publishable_key_here
