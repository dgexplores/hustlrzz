# --- AI providers (multi-provider) ---
# Preferred provider: "groq" (free tier, no card) or "gemini"
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Supabase (auth + Postgres) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- App ---
CORS_ORIGINS=http://localhost:3000,https://hustlrzzv2.vercel.app
DEFAULT_QUESTION_COUNT=50

# --- Candidate knowledge (RAG, optional) ---
# Uses Gemini embeddings and the pgvector schema migration. Chat can still use
# Groq while Gemini is configured only for retrieval.
RAG_EMBEDDING_MODEL=models/text-embedding-004
RAG_EMBEDDING_DIMENSIONS=768
RAG_MAX_DOCUMENT_CHARS=200000
RAG_CHUNK_CHARS=900
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
