# ============================================================
# Hustlrzz backend configuration
# Copy this file to backend/.env and fill in your own values.
# ============================================================

# --- AI (Groq — free tier, no credit card) -------------------
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Model used for every text generation (free tier ~1000 req/day)
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
# Optional: transcription (Whisper) and TTS (Orpheus) models
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=tara

# --- Supabase (auth + database) --------------------------------
# Create a free project at https://supabase.com (no credit card needed),
# run supabase_schema.sql in the SQL editor, then copy from:
#   Project Settings -> API (or Dashboard -> Connect)
SUPABASE_URL=https://<project-ref>.supabase.co
# service_role (secret) key — backend-only, NEVER exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# --- CORS -----------------------------------------------------
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5000,http://localhost,https://hustlrzz.vercel.app
