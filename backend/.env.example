# --- AI providers (multi-provider) ---
# Preferred provider: "groq" (free tier, no card) or "gemini"
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Supabase (auth + Postgres) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
CORS_ORIGINS=http://localhost:3000,https://hustlrzzv2.vercel.app
# Required for Vercel Preview deployments with unique hostnames. Keep this
# narrow to YOUR team's hosts - it gates credentialed cross-origin requests.
CORS_ORIGIN_REGEX=https://frontend-[a-z0-9-]+-your-vercel-team\.vercel\.app
DEFAULT_QUESTION_COUNT=12
# Source-aware company research is enabled by default and degrades to the
# built-in interview profile if the public search provider is unavailable.
ENABLE_WEB_SEARCH=true
AI_REQUEST_TIMEOUT_SECONDS=60
WEB_SEARCH_TIMEOUT_SECONDS=15

# --- Per-user rate limits (sliding window) ---
RATE_WORKFLOWS_PER_MIN=6
RATE_COACHING_PER_MIN=12
RATE_KNOWLEDGE_PER_MIN=10
RATE_INTERVIEW_STARTS_PER_MIN=8
RATE_ASSESSMENT_PER_HOUR=6

# --- Live interview session hygiene ---
SESSION_TTL_SECONDS=3600
WS_TOKEN_TTL_SECONDS=1800

# --- Company intelligence (auto-refresh cache) ---
COMPANY_INTEL_TTL_DAYS=7


# --- Resume Analyzer ---
# The database migration enforces this per-user daily free quota in Asia/Kolkata.
RESUME_ANALYZER_FREE_DAILY_LIMIT=3
RESUME_ANALYZER_MAX_JD_CHARS=60000

# --- Candidate knowledge (RAG, optional) ---
# Uses Gemini embeddings and the pgvector schema migration. Chat can still use
# Groq while Gemini is configured only for retrieval.
RAG_EMBEDDING_MODEL=models/text-embedding-004
RAG_EMBEDDING_DIMENSIONS=768
RAG_MAX_DOCUMENT_CHARS=200000
RAG_CHUNK_CHARS=900
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
