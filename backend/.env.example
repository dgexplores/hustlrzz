# ============================================================
# Hustlrzz backend configuration
# Copy this file to backend/.env and fill in your own values.
# ============================================================

# --- AI (Groq — free tier, no credit card) -------------------
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Model used for every text generation (free tier ~1000 req/day)
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
# Optional: transcription (Whisper) and TTS (Orpheus) models
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=tara

# --- Firebase (auth + database) ------------------------------
# Create a Firebase project, enable Authentication (Email + Google)
# and Firestore, then download the service account key JSON
# (Project settings -> Service accounts -> Generate new private key).
# Place the file at backend/credentials/firebase_key.json
GOOGLE_CLOUD_PROJECT=your-firebase-project-id
FIREBASE_KEY_PATH=credentials/firebase_key.json

# --- CORS -----------------------------------------------------
# Comma-separated origins allowed to call the API.
# Add your deployed frontend URL here (e.g. https://intelliview.vercel.app)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5000,http://localhost,https://your-frontend-domain.com
